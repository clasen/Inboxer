{
  "name": "inboxer",
  "version": "0.5.1",
  "description": "A self-hosted mail layer for agents: persists every inbound and outbound email, exposes an MCP server, and ships a minimal UI to review drafts.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "skills/inboxer/SKILL.md"
  ],
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"require('node:fs').cpSync('src/ui/static','dist/ui/static',{recursive:true})\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test 'test/**/*.test.ts'",
    "test:bun": "bun test test",
    "prepack": "npm run build",
    "preview": "node scripts/preview.ts"
  },
  "keywords": [
    "email",
    "mail",
    "mailbox",
    "inbox",
    "inbound-email",
    "drafts",
    "threading",
    "support",
    "helpdesk",
    "customer-support",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "agent",
    "ai",
    "llm",
    "claude",
    "skill",
    "resend",
    "webhook",
    "self-hosted",
    "htmx",
    "hono",
    "sqlite",
    "deepbase",
    "roster-server",
    "bun",
    "nodejs",
    "clasen"
  ],
  "author": "Martin Clasen",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/clasen/Inboxer.git"
  },
  "bugs": {
    "url": "https://github.com/clasen/Inboxer/issues"
  },
  "homepage": "https://github.com/clasen/Inboxer#readme",
  "dependencies": {
    "@hono/node-server": "^2.1.8",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "deepbase": "^4.0.0",
    "deepbase-sqlite": "^4.0.0",
    "hono": "^4.13.18",
    "svix": "^2.10.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2"
  }
}
